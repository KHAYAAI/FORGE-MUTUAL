{
  "name": "@forge/backoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Back office for staff: cases, payment decisions, repair and reconciliation. Talks only to backoffice-api, through its own origin.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../services/shared/backoffice-api/openapi/backoffice.yaml -o lib/api/schema.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
